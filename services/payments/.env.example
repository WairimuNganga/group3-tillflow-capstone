# Copy to services/payments/.env and fill in. Never commit .env.
#   cp .env.example .env

# --- Runtime ---
TILLFLOW_TELEMETRY_EXPORT=none
SERVICE_NAME=payments

# Local Postgres (optional — omit to use in-memory stores)
DATABASE_URL=postgresql+asyncpg://payments:secret@localhost:5432/tillflow

# --- M-Pesa ---
# Use "fake" for tests/CI. Use "sandbox" only for manual Daraja smoke tests.
MPESA_ADAPTER=sandbox

# Callback path secret (must match the URL path segment below)
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string

# Daraja sandbox (from https://developer.safaricom.co.ke — sandbox app)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=

# Public HTTPS URL Daraja can reach (ngrok / cloudflare tunnel), including secret:
#   https://xxxx.ngrok-free.app/callbacks/mpesa/<MPESA_CALLBACK_SECRET>
DARAJA_STK_CALLBACK_URL=

# B2C (only needed if testing payouts)
DARAJA_INITIATOR=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_B2C_RESULT_URL=
