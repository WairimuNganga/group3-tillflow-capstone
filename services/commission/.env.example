# Copy to services/commission/.env — never commit .env.

TILLFLOW_TELEMETRY_EXPORT=none
SERVICE_NAME=commission

# Local Postgres — shared tillflow DB with POS/payments (omit for in-memory stores).
# Bootstrap role/grants: psql -f local/init-db.sql (see local/README.md).
DATABASE_URL=postgresql+asyncpg://commission:secret@localhost:5432/tillflow

# Payments B2C (Service Connect in AWS)
PAYMENTS_BASE_URL=http://127.0.0.1:8080

# SQS payout queue (empty = in-memory queue for local/tests)
PAYOUT_QUEUE_URL=
