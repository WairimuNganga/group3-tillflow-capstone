                        ALTER DEFAULT PRIVILEGES FOR ROLE tillflow_commission_owner IN SCHEMA commission
                          GRANT EXECUTE ON FUNCTIONS TO tillflow_commission;
                
                        ALTER ROLE tillflow_web SET search_path = web;
                        ALTER ROLE tillflow_pos SET search_path = pos;
                        ALTER ROLE tillflow_payments SET search_path = payments;
                        ALTER ROLE tillflow_commission SET search_path = commission;
