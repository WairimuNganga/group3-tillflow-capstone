                        import json
                        import os
                
                        host = os.environ["DB_HOST"]
                        db_name = os.environ["DB_NAME"]
                        services = {
                            "web": ("tillflow_web", os.environ["WEB_PASSWORD"]),
                            "pos": ("tillflow_pos", os.environ["POS_PASSWORD"]),
                            "payments": ("tillflow_payments", os.environ["PAYMENTS_PASSWORD"]),
                            "commission": ("tillflow_commission", os.environ["COMMISSION_PASSWORD"]),
                        }
                
                        # ECS json-key injection is reliable for strings. Nested objects can be
                        # injected in a non-JSON representation, so keep each selected service
                        # value as a JSON string that the app parses from DB_CREDENTIALS.
                        payload = {}
                        for service, (username, password) in services.items():
                            credentials = {
                                "username": username,
                                "password": password,
                                "host": host,
                                "port": 5432,
                                "dbname": db_name,
                                "schema": service,
                                "sslmode": "require",
                            }
                            payload[service] = json.dumps(credentials, separators=(",", ":"))
                        print(json.dumps(payload, separators=(",", ":")))
