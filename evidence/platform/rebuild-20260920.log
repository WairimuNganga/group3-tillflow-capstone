                            "web": ("tillflow_web", os.environ["WEB_PASSWORD"]),
                            "pos": ("tillflow_pos", os.environ["POS_PASSWORD"]),
                            "payments": ("tillflow_payments", os.environ["PAYMENTS_PASSWORD"]),
                            "commission": ("tillflow_commission", os.environ["COMMISSION_PASSWORD"]),
                        }
                
                        for service, secret_arn in proxy_secret_arns.items():
                            username, password = services[service]
                            payload = json.dumps(
                                {"username": username, "password": password},
                                separators=(",", ":"),
                            )
                            subprocess.run(
                                [
                                    "aws",
                                    "secretsmanager",
                                    "put-secret-value",
                                    "--secret-id",
                                    secret_arn,
                                    "--secret-string",
                                    payload,
                                ],
                                check=True,
                                stdout=subprocess.DEVNULL,
                            )
