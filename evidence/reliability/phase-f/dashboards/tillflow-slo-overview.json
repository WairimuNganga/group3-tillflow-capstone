        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "1 - (sum(rate(web_requests_total{status=~\"5xx\"}[5m])) / clamp_min(sum(rate(web_requests_total[5m])), 1e-9))",
          "legendFormat": "web success",
          "refId": "A"
        },
        {
          "expr": "1 - (sum(rate(pos_requests_total{status=~\"5xx\"}[5m])) / clamp_min(sum(rate(pos_requests_total[5m])), 1e-9))",
          "legendFormat": "pos success",
          "refId": "B"
        },
        {
          "expr": "1 - (sum(rate(payments_requests_total{status=~\"5xx\"}[5m])) / clamp_min(sum(rate(payments_requests_total[5m])), 1e-9))",
          "legendFormat": "payments success",
          "refId": "C"
        }
      ],
      "title": "Availability SLI \u2014 success ratio",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "AMP"
      },
      "fieldConfig": {
