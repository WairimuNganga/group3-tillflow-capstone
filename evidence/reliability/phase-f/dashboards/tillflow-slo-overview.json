        {
          "expr": "(sum(rate(web_requests_total{status=~\"5xx\"}[5m])) / clamp_min(sum(rate(web_requests_total[5m])), 1e-9)) / 0.001",
          "legendFormat": "web burn vs 99.9%",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(pos_requests_total{status=~\"5xx\"}[5m])) / clamp_min(sum(rate(pos_requests_total[5m])), 1e-9)) / 0.001",
          "legendFormat": "pos burn vs 99.9%",
          "refId": "C"
        }
      ],
